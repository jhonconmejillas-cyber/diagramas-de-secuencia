{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "SRB - Modificacion de Reserva",
    "output": "modificacion-reserva.html",
    "viewBox": [1040, 640],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    { "id": "cliente", "type": "external", "label": "Cliente", "sublabel": "proceso consumidor" },
    { "id": "gt", "type": "backend", "label": "Gestor de Transacciones", "sublabel": "enrutador sincrono" },
    { "id": "rmc", "type": "backend", "label": "Servicio RMC", "sublabel": "reserva/mod/consulta" },
    { "id": "persistencia", "type": "backend", "label": "Servicio de Persistencia", "sublabel": "acceso a datos" },
    { "id": "bd", "type": "database", "label": "BD (PostgreSQL)", "sublabel": "eventos y reservas" }
  ],
  "segments": [
    { "from": 150, "to": 215, "label": "Enrutamiento sincrono" },
    { "from": 230, "to": 495, "label": "Chequeo de disponibilidad y ajuste" },
    { "from": 505, "to": 570, "label": "Respuesta al cliente" }
  ],
  "messages": [
    { "id": "req-mod", "from": "cliente", "to": "gt", "y": 160, "label": "modificar reserva (asientos o fecha) (REQ/REP)", "variant": "default" },
    { "id": "gt-rmc", "from": "gt", "to": "rmc", "y": 195, "label": "enrutar modificacion (REQ/REP)", "variant": "emphasis" },
    { "id": "rmc-check", "from": "rmc", "to": "persistencia", "y": 250, "label": "consultar ocurrencias y disponibilidad (REQ/REP)", "variant": "default" },
    { "id": "persist-select", "from": "persistencia", "to": "bd", "y": 282, "label": "SELECT ocurrencias + asientos", "variant": "default" },
    { "id": "bd-rows", "from": "bd", "to": "persistencia", "y": 314, "label": "filas", "variant": "return" },
    { "id": "persist-avail", "from": "persistencia", "to": "rmc", "y": 346, "label": "ocurrencias + disponibilidad (REP)", "variant": "return", "note": "Cambio de fecha con una sola ocurrencia en el mes: se rechaza, solo se admite cambiar el numero de asientos" },
    { "id": "rmc-apply", "from": "rmc", "to": "persistencia", "y": 386, "label": "aplicar modificacion (REQ/REP)", "variant": "emphasis", "note": "Si no hay disponibilidad, se rechaza y la reserva original no cambia" },
    { "id": "persist-update", "from": "persistencia", "to": "bd", "y": 420, "label": "UPDATE reserva + asientos", "variant": "emphasis" },
    { "id": "bd-ok", "from": "bd", "to": "persistencia", "y": 452, "label": "commit OK", "variant": "return" },
    { "id": "persist-ok", "from": "persistencia", "to": "rmc", "y": 484, "label": "modificacion aplicada (REP)", "variant": "return" },
    { "id": "rmc-gt", "from": "rmc", "to": "gt", "y": 520, "label": "exito / rechazo (REP)", "variant": "return" },
    { "id": "gt-cliente", "from": "gt", "to": "cliente", "y": 555, "label": "resultado de la modificacion (REP)", "variant": "return" }
  ],
  "activations": [
    { "participant": "gt", "from": 160, "to": 560, "type": "backend" },
    { "participant": "rmc", "from": 195, "to": 525, "type": "backend" },
    { "participant": "persistencia", "from": 250, "to": 489, "type": "backend" },
    { "participant": "bd", "from": 282, "to": 319, "type": "database" },
    { "participant": "bd", "from": 420, "to": 457, "type": "database" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Camino feliz",
      "items": [
        "RMC busca cupo en otra ocurrencia del mismo evento en el mes",
        "El ajuste se persiste antes de confirmar al cliente"
      ]
    },
    {
      "dot": "rose",
      "title": "Rechazo atomico",
      "items": [
        "Si no hay asientos en el evento deseado ni en otra ocurrencia, la transaccion se rechaza",
        "Si se pide cambio de fecha y el evento tiene una sola ocurrencia en el mes, se rechaza: solo se admite cambiar el numero de asientos",
        "El cliente queda exactamente como estaba antes de pedir el cambio"
      ]
    }
  ]
}
