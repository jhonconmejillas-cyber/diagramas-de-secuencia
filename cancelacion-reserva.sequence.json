{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "SRB - Cancelacion de Reserva (asincrona)",
    "output": "cancelacion-reserva.html",
    "viewBox": [1040, 540],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    { "id": "cliente", "type": "external", "label": "Cliente", "sublabel": "proceso consumidor" },
    { "id": "gt", "type": "backend", "label": "Gestor de Transacciones", "sublabel": "canal asincrono" },
    { "id": "cancel", "type": "backend", "label": "Servicio de Cancelacion", "sublabel": "cancelacion + notificacion" },
    { "id": "persistencia", "type": "backend", "label": "Servicio de Persistencia", "sublabel": "acceso a datos" },
    { "id": "bd", "type": "database", "label": "BD (PostgreSQL)", "sublabel": "eventos y reservas" }
  ],
  "segments": [
    { "from": 150, "to": 205, "label": "Aceptacion no bloqueante" },
    { "from": 215, "to": 440, "label": "Liberacion y notificacion diferida" }
  ],
  "messages": [
    { "id": "req-cancel", "from": "cliente", "to": "gt", "y": 160, "label": "cancelar reserva + direccion de contacto (REQ/REP)", "variant": "default", "note": "El cliente abre un PULL en su propio puerto para recibir la notificacion" },
    { "id": "gt-ack", "from": "gt", "to": "cliente", "y": 192, "label": "ack inmediato de recepcion (REP)", "variant": "dashed" },
    { "id": "gt-cancel", "from": "gt", "to": "cancel", "y": 235, "label": "enviar cancelacion (PUSH/PULL)", "variant": "dashed" },
    { "id": "cancel-release", "from": "cancel", "to": "persistencia", "y": 275, "label": "liberar asientos (REQ/REP)", "variant": "default" },
    { "id": "persist-update", "from": "persistencia", "to": "bd", "y": 310, "label": "UPDATE asientos + reserva", "variant": "default" },
    { "id": "bd-ok", "from": "bd", "to": "persistencia", "y": 345, "label": "commit OK", "variant": "return" },
    { "id": "persist-ok", "from": "persistencia", "to": "cancel", "y": 380, "label": "liberacion confirmada (REP)", "variant": "return" },
    { "id": "cancel-notify", "from": "cancel", "to": "cliente", "y": 425, "label": "notificacion, cancelacion efectuada (PUSH/PULL al PULL del cliente)", "variant": "dashed", "note": "Va directo al cliente, sin pasar de nuevo por el Gestor de Transacciones" }
  ],
  "activations": [
    { "participant": "gt", "from": 160, "to": 240, "type": "backend" },
    { "participant": "cancel", "from": 235, "to": 430, "type": "backend" },
    { "participant": "persistencia", "from": 275, "to": 385, "type": "backend" },
    { "participant": "bd", "from": 310, "to": 350, "type": "database" }
  ],
  "cards": [
    {
      "dot": "orange",
      "title": "Patron asincrono",
      "items": [
        "El ack de recepcion es inmediato y no espera la liberacion real",
        "La liberacion en persistencia ocurre despues, fuera del ciclo de respuesta",
        "La notificacion final llega al cliente por un canal separado del Gestor de Transacciones"
      ]
    }
  ]
}
